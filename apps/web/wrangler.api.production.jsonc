{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fakeminjun-platform-api",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-22",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "fakeminjun.vip/api/*",
      "zone_name": "fakeminjun.vip"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fakeminjun-platform-prod",
      "database_id": "1e8d5ff1-cfe7-4176-b6fa-735739b2c243",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHYSICS_FILES",
      "bucket_name": "fakeminjun-physics-vault"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "APP_ORIGIN": "https://fakeminjun.vip",
    "PHYSICS_SCANNER_ENABLED": "true"
  },
  "triggers": {
    "crons": [
      "*/10 * * * *"
    ]
  }
}
